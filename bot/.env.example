# ─── Telegram ────────────────────────────────────────────────────────────────
# Token del bot (de @BotFather)
BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat IDs de los admins separados por coma (Dr. Rolo, secretaria, vos mientras configurás)
# Obtener cada chat_id: hablar con @userinfobot en Telegram
# Para salirte después: simplemente quitá tu ID de la lista y reiniciá el bot
ADMIN_CHAT_IDS=111111111,222222222,333333333

# ─── Google Calendar OAuth2 ──────────────────────────────────────────────────
# Crear en https://console.cloud.google.com → APIs → Credenciales → OAuth 2.0 → Aplicación de escritorio
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto local para recibir el callback OAuth (no necesita estar expuesto a internet)
OAUTH_PORT=9876
